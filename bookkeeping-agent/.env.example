# Copy to .env and fill in locally. .env is gitignored; this file is not.
# Shell exports override these values.

# Preferred LLM credential
XAI_API_KEY=

# Fallback LLM credential
OPENAI_API_KEY=

# Optional. Defaults: grok-4 with XAI, gpt-4o with OpenAI.
BOOKKEEPING_MODEL=grok-4

# Postman environment only (Plaid API Endpoints collection). The Python agent
# reads local JSON dumps and does not call Plaid.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
